NODE_ENV=development

# npm run docker:dev — host port for the API container (container listens on 3000 internally)
API_PORT=3003
# npm run start:dev / dev:local — host port for Nest on your machine (must NOT equal API_PORT)
PORT=3002

# PostgreSQL
POSTGRES_USER=wqms_user
POSTGRES_PASSWORD=wqms_local_password
POSTGRES_DB=wqms_db
POSTGRES_PORT=5436

# Host machine → DB (pgAdmin, Prisma CLI, local npm run)
DATABASE_URL=postgresql://wqms_user:wqms_local_password@localhost:5436/wqms_db

# Inside Docker Compose, DATABASE_URL is overridden to use hostname "postgres".

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth
JWT_SECRET=wqms-dev-jwt-secret-change-me-now
JWT_EXPIRES_IN=8h

# Default SYSTEM_ADMIN (seeded by migration + db:seed)
SYSTEM_ADMIN_EMAIL=system.admin@prmsc.gov.pk
SYSTEM_ADMIN_PASSWORD=ChangeMe@123

# ── pgAdmin (General → Name: "WQMS Local") ───────────────────────────────────
# Host: localhost | Port: 5436 | Database: wqms_db
# Username: wqms_user | Password: wqms_local_password
